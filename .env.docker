# ============================================================
# Docker environment — copy this file and fill in real values.
# Used by docker-compose.yml via env_file / environment blocks.
# DO NOT commit secrets to version control.
# ============================================================


# ── Backend ─────────────────────────────────────────────────

PORT=8000

# MongoDB — uses the "mongo" service name inside Docker network
MONGODB_URI=mongodb://mongo:27017/virgin-travel

# JWT secrets — replace with long random strings in production
ACCESS_SECRET_JWT=change_me_access_secret
REFRESH_SECRET_JWT=change_me_refresh_secret

# CORS — origin from which the browser sends requests to the API
# For local Docker: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000


# ── Frontend (build-time args + runtime) ────────────────────

# URL of the backend as seen by the BROWSER (host-exposed port or public domain)
# Used in next.config.ts remotePatterns — baked in at build time
NEXT_IMAGE_URL=http://localhost:8000/

# Public site URL — baked in at build time (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend URL used by Next.js SERVER-SIDE code (internal Docker network)
NEXT_API_URL=http://backend:8000/api
NEXT_BACK_URL=http://backend:8000

# Optional: WhatsApp contact number
NEXT_WHATSAPP_PHONE=
