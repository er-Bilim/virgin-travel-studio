# ============================================================
# Production environment — copy to .env.production on the VPS
# and fill in real values. NEVER commit .env.production to git.
# ============================================================

# ── MongoDB credentials (used by both mongo container and backend) ───────────
MONGO_ROOT_USER=virgin_root
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Backend ─────────────────────────────────────────────────────────────────
PORT=8000

# MongoDB URI — authenticates against "admin" authSource
# Format: mongodb://<user>:<password>@mongo:27017/<dbname>?authSource=admin
MONGODB_URI=mongodb://virgin_root:CHANGE_ME_STRONG_PASSWORD@mongo:27017/virgin-travel?authSource=admin

# JWT secrets — use long random strings (e.g. openssl rand -hex 64)
ACCESS_SECRET_JWT=CHANGE_ME_ACCESS_SECRET
REFRESH_SECRET_JWT=CHANGE_ME_REFRESH_SECRET

# CORS — the public domain of the site
CORS_ORIGIN=https://yourdomain.com

# ── Frontend (build-time args + runtime) ────────────────────────────────────

# URL of the backend as seen by the BROWSER (via nginx, on the public domain)
# Used in next.config.ts remotePatterns — baked in at build time
NEXT_IMAGE_URL=https://yourdomain.com

# Public site URL — baked in at build time (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Backend URL used by Next.js SERVER-SIDE code (internal Docker network)
NEXT_API_URL=http://backend:8000/api
NEXT_BACK_URL=http://backend:8000

# Optional: WhatsApp contact number (e.g. 79001234567)
NEXT_WHATSAPP_PHONE=
